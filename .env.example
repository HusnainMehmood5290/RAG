# --- Required ---
GOOGLE_API_KEY=your-google-gemini-api-key-here

# --- Model selection (defaults shown) ---
# LLM_NAME=gemini-1.5-flash
# EMBEDDING_NAME=sentence-transformers/all-mpnet-base-v2

# --- Chunking (integers; CHUNK_OVERLAP must be < CHUNK_SIZE) ---
# CHUNK_SIZE=400
# CHUNK_OVERLAP=50
# PARENT_CHUNK_SIZE=4000

# --- Storage paths (relative to project root unless absolute) ---
# LOCAL_STORE=store/local_store
# VECTOR_STORE=store/vector_store
# COLLECTION_NAME=documents

# --- Ingestion ---
# RAW_DATA_DIR=ingestion/raw_data
# PROCESSED_DIR=ingestion/processed
# WATCH_INTERVAL_SECONDS=10

# --- Retrieval / generation ---
# RETRIEVAL_K=4
# MAX_CONTEXT_CHARS=8000

# --- Embedding compute device (set to "cuda" for GPU-accelerated ingestion) ---
# HF_EMBEDDINGS_DEVICE=cpu

# --- Logging ---
# LOG_LEVEL=INFO
